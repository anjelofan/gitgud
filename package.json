{
    "name": "gitgud",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "es:fix": "eslint --cache --fix .",
        "fix": "pnpm fmt:fix && pnpm es:fix",
        "fmt": "prettier --cache --cache-location .prettiercache --check .",
        "fmt:fix": "prettier --cache --cache-location .prettiercache --write .",
        "lint": "pnpm --workspace-root --parallel /^lint:/",
        "lint:es": "eslint --cache .",
        "lint:sv": "svelte-check --tsconfig ./tsconfig.json",
        "test": "pnpm test:unit && pnpm test:e2e",
        "test:e2e": "playwright test",
        "test:e2e:setup": "playwright install chromium",
        "test:unit": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "docker:dev": "docker compose -f compose.yml -f compose.dev.yml up --wait",
        "docker:dev:down": "docker compose -f compose.yml -f compose.dev.yml down --remove-orphans"
    },
    "devDependencies": {
        "@bastidood/eslint-plugin-imsort": "^0.12.0",
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^10.0.1",
        "@html-eslint/eslint-plugin": "^0.65.0",
        "@html-eslint/eslint-plugin-svelte": "^0.65.0",
        "@playwright/test": "^1.62.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "svelte-eslint-parser": "^1.8.1",
        "tailwind-csstree": "^0.3.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
    "dependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/api-logs": "^0.222.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
        "@opentelemetry/instrumentation-http": "^0.222.0",
        "@opentelemetry/instrumentation-pg": "^0.74.0",
        "@opentelemetry/sdk-logs": "^0.222.0",
        "@opentelemetry/sdk-node": "^0.222.0",
        "@opentelemetry/sdk-trace-base": "^2.11.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.23.0",
        "valibot": "^1.4.2"
    }
}
