# Test-only environment for `pnpm test` (unit and end-to-end). Committed on
# purpose: these are fake values, never real credentials. The test harnesses
# load this file and abort when FAKE_GITHUB_PORT is missing or invalid.
FAKE_GITHUB_PORT=4001
SESSION_SECRET=test-session-secret-0123456789abcdef0123456789abcdef
GITHUB_APP_CLIENT_ID=test-client-id
GITHUB_APP_CLIENT_SECRET=test-client-secret
DATABASE_URL=postgresql://postgres:password@localhost:5433/test
