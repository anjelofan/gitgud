# Required — PostgreSQL connection string, used by the app (src/lib/server/db) and drizzle-kit.
# The compose dev stack (pnpm docker:dev) provides these defaults.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Required for auth — GitHub App OAuth credentials and session secret.
# Client ID/secret come from your GitHub App settings (General > About).
# SESSION_SECRET is any random high-entropy string; it derives the session
# secret hashing key and the AES-256-GCM key for stored GitHub tokens.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# SESSION_SECRET=

# Optional — GitHub org used for teacher-role resolution until the classroom
# feature supplies org context per classroom (see FEATURES.md). Leave unset to
# resolve no role. Retire this knob once classrooms exist.
# GITHUB_ORG=

# Test-only — makes the app talk to the local fake GitHub server
# (tests/fake-github/) instead of the real API. The committed `.env.test`
# supplies it (and the fake OAuth credentials) for test runs, which abort
# when it is missing or invalid; the app itself uses the real GitHub API
# when it is unset. Shell-exported values override `.env.test`.
# FAKE_GITHUB_PORT=

# Optional — OpenTelemetry OTLP/HTTP export endpoint and auth headers for local
# telemetry (see src/instrumentation.server.js). Leave unset to disable export;
# in development, logger output then goes to the console instead.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
