# Required — PostgreSQL connection string, used by the app (src/lib/server/db) and drizzle-kit.
# The compose dev stack (pnpm docker:dev) provides these defaults.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional — base URL of the GitHub API. Tests point this at the fake GitHub
# server under tests/fake-github/ (fixed port: http://localhost:4001, same as
# CI in .github/workflows/code-quality.yml); leave unset to use the real API.
# GITHUB_API_BASE=

# Optional — OpenTelemetry OTLP/HTTP export endpoint and auth headers for local
# telemetry (see src/instrumentation.server.js). Leave unset to disable export.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
