# Required — PostgreSQL connection string, used by the app (src/lib/server/db) and drizzle-kit.
# The compose dev stack (pnpm docker:dev) provides these defaults.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Required for auth — GitHub App OAuth credentials and session secret.
# Client ID/secret come from your GitHub App settings (General > About).
# The client ID also serves as the JWT `iss` for installation tokens
# (GitHub docs recommend the client ID over the numeric app ID).
# SESSION_SECRET is any random high-entropy string; it derives the session
# secret hashing key and the AES-256-GCM key for stored GitHub tokens.
#
# Server-to-server GitHub calls (assignment repo provisioning) authenticate
# as the App installation instead of a user; GITHUB_APP_PRIVATE_KEY is the
# app's private key (.pem download) as a single line with newlines escaped
# as \n.
#
# The GitHub App itself must also be configured (see README "Getting started"):
# the Callback URL must list <origin>/auth/callback for every port you run on,
# "Request user authorization (OAuth flow) during installation" must be
# enabled, the app must be made public (students authorize from outside the
# org), and it must be installed on the program's org with Administration and
# Contents read/write repository permissions. Assignment template repos must
# be flagged as template repositories.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# SESSION_SECRET=

# Test-only — makes the app talk to the local fake GitHub server
# (tests/fake-github/) instead of the real API. The committed `.env.test`
# supplies it (and the fake OAuth credentials) for test runs, which abort
# when it is missing or invalid; the app itself uses the real GitHub API
# when it is unset. Shell-exported values override `.env.test`.
# FAKE_GITHUB_PORT=

# Optional — telemetry export to a self-hosted OpenObserve dev stack
# (part of pnpm docker:dev; see docs/OPENOBSERVE.md). The untracked .env.local
# holds OTEL_EXPORTER_OTLP_ENDPOINT + OTEL_EXPORTER_OTLP_HEADERS, matching the
# dev credentials that compose.dev.yml passes to the container.
